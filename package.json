{
  "name": "streetdocmd",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "turbo run dev --filter=admin",
    "dev:patient": "turbo run dev --filter=patient",
    "dev:patient-web": "turbo run dev --filter=patient-web",
    "dev:provider": "turbo run dev --filter=provider",
    "dev:provider-web": "turbo run dev --filter=provider-web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "npm@10.5.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
