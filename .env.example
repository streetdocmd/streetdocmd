# App URL (set per app deployment)
# provider-web: https://provider.streetdocmd.com
# patient-web:  https://app.streetdocmd.com
# admin:        https://admin.streetdocmd.com
NEXT_PUBLIC_APP_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your-key
PAYSTACK_SECRET_KEY=sk_test_your-key

# Termii (Nigerian SMS OTP)
TERMII_API_KEY=your-termii-key
TERMII_SENDER_ID=StreetDoc

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-maps-key
EXPO_PUBLIC_GOOGLE_MAPS_KEY=your-maps-key

# Firebase (Push Notifications)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email

# Resend (Email)
RESEND_API_KEY=re_your-key
RESEND_FROM_EMAIL=hello@streetdocmd.com

# WhatsApp Business API
WHATSAPP_API_TOKEN=your-token
WHATSAPP_PHONE_NUMBER_ID=your-number-id

# Admin
ADMIN_JWT_SECRET=super-secret-change-this-in-production
